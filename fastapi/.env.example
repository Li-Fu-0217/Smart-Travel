# ----- 【一般不用改】服务 -----
APP_NAME=travel-assistant
HOST=0.0.0.0
PORT=8000

# ----- 数据库 -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_assistant
DB_USER=root
DB_PASSWORD=          # 【必改】本机 MySQL 密码

# ----- 【一般不用改】鉴权与上传 -----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000
UPLOAD_PATH=./uploads

# ----- 智能助手 -----
AGENT_DEMO_MODE=true     # 【按需】true=规则编排(无需Key但真实写库)；false=走真实大模型
LLM_API_KEY=             # 【按需】接真模型时填写
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING=disabled    # Tool Calls 建议 disabled
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ----- 【一般不用改】知识库向量目录 -----
CHROMA_PATH=./data/chroma
KNOWLEDGE_COLLECTION=travel_guide_knowledge
